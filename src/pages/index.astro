---
import { getCollection } from 'astro:content';
import Arrow from '../components/Arrow.astro';
import BlogCard from '../components/BlogCard.astro';
import Curve from '../components/Curve.astro';
import Index from '../components/Index.astro';
import Lines from '../components/Lines.astro';
import Media from '../components/Media.astro';
import ProcessTrack from '../components/ProcessTrack.astro';
import ProjectFigure from '../components/ProjectFigure.astro';
import ServicesExplorer from '../components/ServicesExplorer.astro';
import { getPosts } from '../data/blog';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';

import heroImg from '../assets/projeler/yapi-showroom/04.webp';
import inlineImg from '../assets/projeler/yapi-showroom/03.webp';
import detailImg from '../assets/projeler/yapi-showroom/07.webp';
import blueImg from '../assets/projeler/yapi-showroom/02.webp';

const projects = (await getCollection('projeler')).sort((a, b) => a.data.order - b.data.order);
const [p1, p2, p3] = projects;
const posts = (await getPosts()).slice(0, 3);
---

<Base>
  <!-- (01) Açılış: tipografi, mimari görsel, boşluk ve küçük üst veri birlikte bir kompozisyon -->
  <section class="hero" data-hero aria-labelledby="hero-title">
    <div class="hero__visual">
      <span class="hero__blue" aria-hidden="true"></span>
      <Media
        class="hero__media"
        src={heroImg}
        alt="Yapı Showroom: damarlı mermer ada, bar tabureleri ve sıcak ışıklı raflar"
        sizes="(min-width: 1024px) 37vw, 82vw"
        reveal={false}
        parallax
        eager
        position="58% 50%"
      />
    </div>

    <ul class="hero__meta micro" role="list" aria-label="Hizmet alanları">
      <li class="hero__meta-no">01</li>
      {site.services.map((s) => <li>{s}</li>)}
    </ul>

    <Lines
      as="h1"
      id="hero-title"
      class="display hero__title"
      reveal={false}
      lines={['Mekân', 'İnsanla', 'Tamamlanır<span class="coral">.</span>']}
    />

    <div class="hero__side">
      <p class="hero__lead">
        Estetik ve işlevselliği birleştirerek yaşam alanlarınızı yeniden tanımlıyoruz; size özel ve zamansız mekânlar
        tasarlıyoruz.
      </p>
      <a href="/projelerimiz" class="cta">
        <span class="cta__circle"><Arrow /></span>
        <span>Projelerimizi keşfedin</span>
      </a>
    </div>

    <p class="hero__foot micro">
      <span>İç mimarlık stüdyosu</span>
      <span class="hero__foot-line" aria-hidden="true"></span>
      <span>{site.city}</span>
    </p>

    <Curve class="hero__curve" mode="load" viewBox="0 0 600 900" d="M40 900 C 120 640, 420 620, 470 360 S 380 40, 600 -20" />
  </section>

  <!-- (02) Manifesto -->
  <section class="manifesto section" aria-labelledby="manifesto-title">
    <div class="grid">
      <Index no="02" label="Yaklaşım" class="manifesto__index" />
      <h2 id="manifesto-title" class="manifesto__text">
        Tasarımlarımızda yalnızca göze hitap etmeyi değil,{' '}
        <span class="manifesto__inline" aria-hidden="true">
          <Media src={inlineImg} alt="" sizes="12rem" reveal={false} />
        </span>{' '}
        <em>ruhunuzu dinlendirecek</em> alanlar yaratmayı hedefliyoruz.
      </h2>
      <div class="manifesto__body">
        <p class="muted">
          Her projeyi bir hikâye olarak görüyoruz. Yaşam tarzınızı, zevklerinizi ve ihtiyaçlarınızı derinlemesine
          anlayarak size özel tasarımlar yaratıyor; kaliteli malzeme ve titiz işçilikle hayata geçiriyoruz.
        </p>
        <a href="/hakkimizda" class="link small">Hakkımızda <Arrow /></a>
      </div>
    </div>
  </section>

  <!-- (03) Projeler — eşit kart ızgarası değil, ritimli bir editoryal kompozisyon -->
  <section class="works section" aria-labelledby="works-title">
    <div class="grid works__head">
      <Index no="03" label="Seçili işler" class="works__index" />
      <Lines as="h2" id="works-title" class="h1 works__title" lines={['Projeler']} reveal={false} />
      <div class="works__intro">
        <p class="muted small">
          Gerçekleştirdiğimiz projelerden seçkiler: konut ve ticari mekânlarda farklı yaşam biçimlerine özel çözümler.
        </p>
        <a href="/projelerimiz" class="link small">Tüm projeler <Arrow /></a>
      </div>
    </div>

    <div class="grid works__comp">
      <ProjectFigure
        project={p1}
        no="01"
        class="works__a"
        ratio="16 / 10"
        sizes="(min-width: 1024px) 64vw, 100vw"
        from="left"
      />
      <div class="works__b-wrap">
        <span class="works__blue" aria-hidden="true"></span>
        <ProjectFigure
          project={p2}
          no="02"
          class="works__b"
          ratio="3 / 4"
          sizes="(min-width: 1024px) 26vw, 80vw"
          position="50% 50%"
        />
      </div>
      <figure class="works__detail">
        <Media src={detailImg} alt="Yapı Showroom: seramik ve doğal taş numune paneli" sizes="(min-width: 1024px) 16vw, 45vw" ratio="1" />
        <figcaption class="micro muted">Detay — malzeme paneli</figcaption>
      </figure>
      <ProjectFigure
        project={p3}
        no="03"
        class="works__c"
        ratio="16 / 9"
        sizes="(min-width: 1024px) 58vw, 100vw"
        position="50% 62%"
        from="right"
      />
    </div>
  </section>

  <!-- (04) Hizmetler -->
  <section class="svc section" aria-labelledby="svc-title">
    <div class="grid svc__head">
      <Index no="04" label="Hizmetler" class="svc__index" />
      <Lines as="h2" id="svc-title" class="h2 svc__title" lines={['Farklı ölçeklerde,', 'aynı hassasiyet.']} reveal={false} />
    </div>
    <ServicesExplorer />
    <div class="wrap svc__more">
      <a href="/hizmetlerimiz" class="link small">Hizmetlerin ayrıntıları <Arrow /></a>
    </div>
  </section>

  <!-- (05) Süreç -->
  <section class="proc section on-dark" data-process aria-labelledby="proc-title">
    <div class="grid">
      <div class="proc__aside">
        <Index no="05" label="Süreç" />
        <Lines as="h2" id="proc-title" class="h2 proc__title" lines={['Keşiften', 'teslime.']} reveal={false} />
        <p class="muted proc__lead">
          Her projeye sizi anlamakla başlıyoruz. Süreç ne kadar şeffaf olursa sonuç o kadar güçlü olur.
        </p>
        <a href="/surecimiz" class="link small">Sürecimiz <Arrow /></a>
      </div>
      <div class="proc__track">
        <ProcessTrack />
      </div>
    </div>
  </section>

  <!-- (06) Ultramarin anı -->
  <section class="detail section section--l" aria-labelledby="detail-title">
    <span class="detail__field" aria-hidden="true"></span>
    <div class="grid">
      <Lines as="h2" id="detail-title" class="h1 detail__title" lines={['Detay', '<em>fark</em>', 'yaratır.']} />
      <p class="detail__text muted">
        Bir kapı kolunun eldeki ağırlığı, tezgâhın kenar profili, sabah ışığının taşa düştüğü açı. Bütünü güçlendiren şey
        çoğu zaman en küçük karardır.
      </p>
      <Media
        class="detail__img"
        src={blueImg}
        alt="Yapı Showroom: taş tezgâhlı ada, ahşap kapı ve asılı yeşillik"
        sizes="(min-width: 1024px) 34vw, 80vw"
        ratio="4 / 5"
        position="62% 50%"
      />
    </div>
  </section>

  <!-- (07) Blog -->
  <section class="journal section" aria-labelledby="journal-title">
    <div class="grid journal__head">
      <Index no="06" label="Blog" />
      <Lines as="h2" id="journal-title" class="h1 journal__title" lines={['Günlük']} reveal={false} />
      <p class="journal__intro muted small">Tasarım, yaşam ve mekân üzerine notlar; malzemeden uygulamaya pratik öneriler.</p>
    </div>
    <div class="grid journal__grid">
      <div class="journal__feature">
        <BlogCard post={posts[0]} size="feature" sizes="(min-width: 1024px) 56vw, 100vw" ratio="4 / 3" />
      </div>
      <div class="journal__side">
        <BlogCard post={posts[1]} size="small" sizes="(min-width: 1024px) 28vw, 100vw" ratio="3 / 2" delay={120} />
        <BlogCard post={posts[2]} size="small" sizes="(min-width: 1024px) 22vw, 100vw" ratio="1" delay={200} />
      </div>
    </div>
    <div class="wrap journal__more">
      <a href="/blog" class="link small">Tüm yazılar <Arrow /></a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: max(100svh, 44rem);
    padding: calc(var(--header-h) + var(--space-l)) var(--gutter) var(--space-m);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr auto auto;
    column-gap: var(--col-gap);
    overflow: clip;
  }
  .hero__visual {
    position: absolute;
    top: calc(var(--header-h) + 1.5rem);
    right: 0;
    bottom: 4.5rem;
    width: 36vw;
  }
  .hero__visual :global(.hero__media) {
    position: absolute;
    inset: 0;
  }
  .hero__blue {
    position: absolute;
    left: -7vw;
    bottom: -2.5rem;
    width: 13vw;
    height: 38%;
    background: var(--ultra);
    transform-origin: bottom;
  }
  .hero__meta {
    position: absolute;
    top: calc(var(--header-h) + 1.75rem);
    right: calc(36vw + var(--col-gap));
    display: grid;
    justify-items: end;
    gap: 0.35rem;
    color: var(--ink-muted);
  }
  .hero__meta-no {
    font-family: var(--serif);
    font-size: 0.95rem;
    letter-spacing: 0;
    color: var(--coral);
    margin-bottom: 0.4rem;
  }
  .hero :global(.hero__title) {
    grid-column: 1 / -1;
    grid-row: 2;
    align-self: center;
    position: relative;
    z-index: 2;
  }
  .hero :global(.hero__title .line:nth-child(2)) {
    padding-left: 0.62em;
  }
  .hero__side {
    grid-column: 1 / span 4;
    grid-row: 3;
    display: grid;
    gap: 1.75rem;
    margin-top: 3rem;
    position: relative;
    z-index: 2;
  }
  .hero__lead {
    max-width: 23rem;
    color: var(--ink-muted);
  }
  .hero__foot {
    grid-column: 1 / span 6;
    grid-row: 4;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
    color: var(--ink-muted);
  }
  .hero__foot-line {
    width: 3.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.4;
  }
  .hero :global(.hero__curve) {
    right: 3vw;
    top: calc(var(--header-h) + 4vh);
    width: 44vw;
    height: calc(96% - var(--header-h) - 4vh);
    z-index: 3;
  }

  /* Hero hareketi: önce görsel maskeyle, sonra başlık satırları, en son üst veri */
  :global(html.js) .hero__visual :global(.hero__media) {
    transition: clip-path 1.3s var(--ease-io);
  }
  :global(html.js) .hero__visual :global(.hero__media img) {
    transition: transform 2s var(--ease);
  }
  :global(html.js) .hero:not(:global(.is-in)) .hero__visual :global(.hero__media) {
    clip-path: inset(100% 0 0 0);
  }
  :global(html.js) .hero:not(:global(.is-in)) .hero__visual :global(.hero__media img) {
    transform: scale(1.14);
  }
  :global(html.js) .hero__blue {
    transition: transform 1.1s var(--ease-io) 550ms;
  }
  :global(html.js) .hero:not(:global(.is-in)) .hero__blue {
    transform: scaleY(0);
  }
  :global(html.js) .hero :global(.hero__title .line > span) {
    transition-delay: calc(var(--i) * 100ms + 380ms);
  }
  :global(html.js) .hero:not(:global(.is-in)) :global(.hero__title .line > span) {
    /* global .line maskesiyle aynı mesafe: aksanlar dahil glif tamamen maskenin dışında başlar */
    transform: translateY(calc(100% + 0.6em));
  }
  :global(html.js) .hero__side,
  :global(html.js) .hero__meta,
  :global(html.js) .hero__foot {
    transition:
      opacity var(--dur-2) var(--ease) 900ms,
      transform var(--dur-2) var(--ease) 900ms;
  }
  :global(html.js) .hero:not(:global(.is-in)) .hero__side,
  :global(html.js) .hero:not(:global(.is-in)) .hero__meta,
  :global(html.js) .hero:not(:global(.is-in)) .hero__foot {
    opacity: 0;
    transform: translateY(0.75rem);
  }

  @media (max-width: 1023px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--header-h) + 2.5rem);
      grid-template-rows: auto auto auto auto auto;
    }
    .hero :global(.hero__title) {
      grid-row: 1;
      margin-top: 0;
    }
    .hero__visual {
      position: relative;
      inset: auto;
      grid-column: 3 / -1;
      grid-row: 2;
      width: auto;
      margin-right: calc(var(--gutter) * -1);
      margin-top: 1.75rem;
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 600px) {
      .hero__visual {
        aspect-ratio: 5 / 4;
      }
    }
    .hero__blue {
      left: calc(var(--gutter) * -1 - 16vw);
      width: 22vw;
      height: 34%;
      bottom: 12%;
    }
    .hero__meta {
      position: static;
      grid-column: 1 / span 2;
      grid-row: 2;
      align-self: start;
      justify-items: start;
      margin-top: 2rem;
      font-size: 0.6rem;
      letter-spacing: 0.16em;
    }
    .hero__side {
      grid-column: 1 / -1;
      grid-row: 3;
      margin-top: 2.25rem;
    }
    .hero__foot {
      grid-column: 1 / -1;
      grid-row: 4;
      margin-top: 2.5rem;
    }
    /* tablet/telefonda eğri metnin üstünden geçerdi: yalnız masaüstünde görselin üzerinde */
    .hero :global(.hero__curve) {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .hero__foot {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .hero__meta {
      display: none;
    }
    .hero__visual {
      grid-column: 2 / -1;
    }
  }

  /* ---------- Yaklaşım ---------- */
  .manifesto .grid {
    row-gap: var(--space-m);
  }
  .manifesto :global(.manifesto__index) {
    grid-column: 1 / span 3;
    align-self: start;
    margin-top: 1.2rem;
  }
  .manifesto__text {
    grid-column: 4 / span 9;
    font-size: clamp(2rem, 1rem + 3.5vw, 4.6rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }
  .manifesto__text em {
    font-style: italic;
    font-weight: 200;
  }
  /* satır içi görsel yalnız masaüstünde: metnin bir kelimesi gibi taban çizgisine oturur */
  .manifesto__inline {
    display: inline-block;
    width: 2.2em;
    height: 0.78em;
    vertical-align: baseline;
    margin-inline: 0.04em 0.1em;
  }
  .manifesto__inline :global(.media) {
    width: 100%;
    height: 100%;
  }
  .manifesto__body {
    grid-column: 8 / span 4;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  @media (max-width: 1023px) {
    .manifesto :global(.manifesto__index),
    .manifesto__text,
    .manifesto__body {
      grid-column: 1 / -1;
    }
    .manifesto :global(.manifesto__index) {
      margin-top: 0;
    }
    .manifesto__text {
      font-size: clamp(1.6rem, 0.9rem + 2.8vw, 2.6rem);
      line-height: 1.14;
      max-width: 34rem;
    }
    .manifesto__inline {
      display: none;
    }
    .manifesto__body {
      max-width: 34rem;
    }
  }

  /* ---------- Projeler ---------- */
  .works__head {
    align-items: end;
    row-gap: var(--space-s);
    margin-bottom: var(--space-l);
  }
  .works :global(.works__index) {
    grid-column: 1 / -1;
  }
  .works :global(.works__title) {
    grid-column: 1 / span 7;
  }
  .works__intro {
    grid-column: 9 / span 4;
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding-bottom: 0.6rem;
  }
  .works__comp {
    position: relative;
    row-gap: var(--space-l);
  }
  .works :global(.works__a) {
    grid-column: 1 / span 8;
    grid-row: 1;
    margin-left: calc(var(--gutter) * -1);
  }
  .works :global(.works__a .pf__cap) {
    padding-left: var(--gutter);
  }
  .works__b-wrap {
    grid-column: 10 / -1;
    grid-row: 1 / span 2;
    margin-right: calc(var(--gutter) * -1);
    padding-top: var(--space-section-l);
    position: relative;
  }
  .works__b-wrap :global(.pf__cap) {
    padding-right: var(--gutter);
  }
  .works__blue {
    position: absolute;
    left: -3.5vw;
    top: calc(var(--space-section-l) - 3.5vw);
    width: 55%;
    aspect-ratio: 3 / 4;
    background: var(--ultra);
  }
  .works__detail {
    grid-column: 6 / span 2;
    grid-row: 2;
    position: relative;
    z-index: 2;
  }
  .works__detail figcaption {
    margin-top: 0.6rem;
  }
  .works :global(.works__c) {
    grid-column: 2 / span 7;
    grid-row: 3;
  }
  @media (min-width: 1024px) and (max-width: 1279px) {
    .works__b-wrap {
      grid-column: 9 / -1;
    }
    .works__detail {
      grid-column: 5 / span 3;
    }
  }

  /* Tablet: kolaj yerine ofsetli dikey akış; her proje kendi grubunda */
  @media (max-width: 1023px) {
    .works__head > :global(*) {
      grid-column: 1 / -1 !important;
    }
    .works__intro {
      max-width: 30rem;
    }
    .works :global(.works__a),
    .works__b-wrap,
    .works :global(.works__c) {
      grid-row: auto;
      padding-top: 0;
    }
    .works :global(.works__a) {
      grid-column: 1 / -1;
    }
    .works__b-wrap {
      grid-column: 5 / -1;
    }
    .works :global(.works__c) {
      grid-column: 1 / span 11;
    }
    .works__detail {
      display: none;
    }
    .works__blue {
      left: -2.5rem;
      top: -1.5rem;
      width: 40%;
    }
  }
  /* Telefon */
  @media (max-width: 767px) {
    .works__b-wrap {
      grid-column: 3 / -1;
    }
    .works :global(.works__c) {
      grid-column: 1 / -1;
    }
    .works__blue {
      left: -1.25rem;
      top: -1.25rem;
      width: 45%;
    }
  }

  /* ---------- Hizmetler ---------- */
  .svc__head {
    row-gap: var(--space-s);
    margin-bottom: var(--space-l);
  }
  .svc__head > :global(*) {
    grid-column: 1 / -1;
  }
  .svc :global(.svc__title) {
    grid-column: 1 / span 9;
  }
  .svc__more {
    margin-top: var(--space-m);
  }

  /* ---------- Süreç ---------- */
  .proc .grid {
    row-gap: var(--space-l);
  }
  .proc__aside {
    grid-column: 1 / span 5;
    position: sticky;
    top: calc(var(--header-h) + 3rem);
    align-self: start;
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }
  .proc :global(.proc__title) {
    margin-top: var(--space-xs);
  }
  .proc__lead {
    max-width: 24rem;
  }
  .proc__track {
    grid-column: 7 / -1;
    padding-top: var(--space-l);
  }
  @media (max-width: 1023px) {
    .proc__aside,
    .proc__track {
      grid-column: 1 / -1;
      position: static;
    }
    .proc__track {
      padding-top: 0;
    }
  }

  /* ---------- Ultramarin anı ---------- */
  .detail {
    overflow: clip;
  }
  .detail__field {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 22vw;
    background: var(--ultra);
  }
  .detail .grid {
    align-items: center;
    row-gap: var(--space-m);
  }
  .detail :global(.detail__title) {
    grid-column: 1 / span 6;
    grid-row: 1;
  }
  .detail :global(.detail__title em) {
    font-style: italic;
    font-weight: 200;
    padding-left: 0.9em;
  }
  .detail__text {
    grid-column: 1 / span 4;
    grid-row: 2;
    align-self: start;
  }
  .detail :global(.detail__img) {
    grid-column: 8 / span 4;
    grid-row: 1 / span 2;
    position: relative;
  }
  @media (max-width: 1023px) {
    .detail__field {
      top: auto;
      height: 42%;
      width: 30vw;
    }
    .detail :global(.detail__title),
    .detail__text {
      grid-column: 1 / -1;
      max-width: 30rem;
    }
    .detail :global(.detail__img) {
      grid-column: 4 / span 8;
      grid-row: auto;
    }
  }
  @media (max-width: 767px) {
    .detail :global(.detail__img) {
      grid-column: 2 / span 10;
    }
  }

  /* ---------- Blog ---------- */
  .journal__head {
    align-items: end;
    row-gap: var(--space-s);
    margin-bottom: var(--space-l);
  }
  .journal__head > :global(:first-child) {
    grid-column: 1 / -1;
  }
  .journal :global(.journal__title) {
    grid-column: 1 / span 7;
  }
  .journal__intro {
    grid-column: 9 / span 4;
    padding-bottom: 0.6rem;
  }
  .journal__grid {
    row-gap: var(--space-l);
