---
import type { ImageMetadata } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Arrow from '../../components/Arrow.astro';
import Curve from '../../components/Curve.astro';
import Index from '../../components/Index.astro';
import Lines from '../../components/Lines.astro';
import Media from '../../components/Media.astro';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projeler')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length], no: i + 1, total: projects.length },
  }));
}

interface Props {
  project: CollectionEntry<'projeler'>;
  next: CollectionEntry<'projeler'>;
  no: number;
  total: number;
}
const { project, next, no, total } = Astro.props;
const { title, category, location, year, area, scope, summary, cover, coverAlt, gallery } = project.data;
const { Content } = await render(project);

/*
  Editoryal fotoğraf dizilimi: tam genişlik → boşluk + küçük detay → ikili → büyük kırpma, sonra tekrar.
  Görsel sayısı yetmezse blok tek görsellik bir kırpmaya düşer.
*/
type Img = { src: ImageMetadata; alt: string };
type Block = { kind: 'full' | 'detail' | 'pair' | 'crop'; imgs: Img[] };
const pattern: Block['kind'][] = ['full', 'detail', 'pair', 'crop'];
const blocks: Block[] = [];
let k = 0;
for (let i = 0; i < gallery.length; ) {
  let kind = pattern[k++ % pattern.length];
  if (kind === 'pair' && i + 1 >= gallery.length) kind = 'crop';
  const n = kind === 'pair' ? 2 : 1;
  blocks.push({ kind, imgs: gallery.slice(i, i + n) });
  i += n;
}
const pad = (n: number) => String(n).padStart(2, '0');

const meta = [
  { k: 'Kategori', v: category },
  { k: 'Konum', v: location },
  { k: 'Yıl', v: String(year) },
  ...(area ? [{ k: 'Alan', v: area }] : []),
  ...(scope ? [{ k: 'Kapsam', v: scope }] : []),
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description: summary,
  dateCreated: String(year),
  locationCreated: location,
  creator: { '@type': 'Organization', name: site.name, url: site.url },
};
---

<Base title={title} description={summary} image={cover} schema={schema}>
  <article>
    <header class="ph grid">
      <a href="/projelerimiz" class="ph__back link small"><Arrow class="ph__back-arrow" /> Tüm projeler</a>
      <Index no={`${pad(no)}/${pad(total)}`} label="Proje" class="ph__index" />
      <Lines as="h1" class="display ph__title" lines={[title]} />
      <dl class="ph__meta">
        {
          meta.map((m) => (
            <div>
              <dt class="micro muted">{m.k}</dt>
              <dd>{m.v}</dd>
            </div>
          ))
        }
      </dl>
      <p class="ph__summary lead">{summary}</p>
    </header>

    <Media
      class="ph__hero"
      src={cover}
      alt={coverAlt}
      sizes="100vw"
      ratio="16 / 8"
      reveal={false}
      parallax
      eager
      vtName={`p-${project.id}`}
    />

    <div class="story grid">
      <div class="story__text prose">
        <Content />
      </div>
    </div>

    {
      blocks.length > 0 && (
        <div class="seq">
          {blocks.map((b, bi) => (
            <div class:list={['seq__block grid', `seq--${b.kind}`]}>
              {b.kind === 'full' && <Media class="seq__a" src={b.imgs[0].src} alt={b.imgs[0].alt} sizes="100vw" ratio="16 / 9" parallax />}
              {b.kind === 'detail' && (
                <>
                  <Media class="seq__a" src={b.imgs[0].src} alt={b.imgs[0].alt} sizes="(min-width: 1024px) 26vw, 70vw" ratio="4 / 5" position="60% 50%" />
                  <p class="seq__caption micro muted">
                    <span class="coral">{pad(bi + 1)}</span> — {b.imgs[0].alt}
                  </p>
                </>
              )}
              {b.kind === 'pair' && (
                <>
                  <Media class="seq__a" src={b.imgs[0].src} alt={b.imgs[0].alt} sizes="(min-width: 1024px) 50vw, 100vw" ratio="4 / 5" />
                  <Media class="seq__b" src={b.imgs[1].src} alt={b.imgs[1].alt} sizes="(min-width: 1024px) 34vw, 100vw" ratio="1" delay={150} />
                </>
              )}
              {b.kind === 'crop' && <Media class="seq__a" src={b.imgs[0].src} alt={b.imgs[0].alt} sizes="100vw" ratio="21 / 8" from="left" />}
            </div>
          ))}
        </div>
      )
    }
  </article>

  <a href={`/projelerimiz/${next.id}`} class="next on-dark" data-cursor="Sonraki proje">
    <Curve class="next__curve" viewBox="0 0 1000 500" d="M-10 480 C 260 420, 380 120, 620 160 S 900 380, 1010 20" />
    <div class="grid next__grid">
      <p class="next__label micro">Sonraki proje <Arrow class="arrow--move" /></p>
      <h2 class="h1 next__title">{next.data.title}</h2>
      <p class="next__meta micro">{next.data.category} · {next.data.location} · {next.data.year}</p>
      <div class="next__media">
        <Media src={next.data.cover} alt={next.data.coverAlt} sizes="(min-width: 1024px) 40vw, 100vw" ratio="4 / 3" vtName={`p-${next.id}`} />
      </div>
    </div>
  </a>
</Base>

<style>
  .ph {
    padding-top: calc(var(--header-h) + var(--space-m));
    padding-bottom: var(--space-l);
    row-gap: var(--space-m);
    align-items: end;
  }
  .ph__back {
    grid-column: 1 / -1;
    justify-self: start;
  }
  .ph__back :global(.ph__back-arrow) {
    rotate: 180deg;
  }
  .ph :global(.ph__index) {
    grid-column: 1 / -1;
    margin-top: var(--space-m);
  }
  .ph :global(.ph__title) {
    grid-column: 1 / -1;
  }
  .ph__meta {
    grid-column: 1 / span 7;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.75rem;
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }
  .ph__meta dd {
    margin-top: 0.3rem;
    font-size: var(--fs-small);
  }
  .ph__summary {
    grid-column: 9 / -1;
    color: var(--ink-muted);
  }

  .story {
    padding-block: var(--space-section);
  }
  .story__text {
    grid-column: 6 / span 6;
  }
  .story__text :global(p:first-child) {
    font-family: var(--serif);
    font-size: var(--fs-lead);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .seq {
    display: grid;
    gap: var(--space-section);
    padding-bottom: var(--space-section);
  }
  .seq__block {
    row-gap: var(--space-m);
  }
  .seq--full {
    padding-inline: 0;
  }
  .seq--full :global(.seq__a) {
    grid-column: 1 / -1;
  }
  .seq--detail {
    align-items: end;
  }
  .seq--detail :global(.seq__a) {
    grid-column: 3 / span 3;
  }
  .seq__caption {
    grid-column: 7 / span 4;
    max-width: 22rem;
  }
  .seq--pair {
    align-items: start;
  }
  .seq--pair :global(.seq__a) {
    grid-column: 1 / span 6;
    margin-left: calc(var(--gutter) * -1);
  }
  .seq--pair :global(.seq__b) {
    grid-column: 8 / span 4;
    margin-top: var(--space-l);
  }
  .seq--crop :global(.seq__a) {
    grid-column: 2 / -1;
    margin-right: calc(var(--gutter) * -1);
  }

  .next {
    display: block;
    position: relative;
    overflow: hidden;
    padding-block: var(--space-section);
  }
  .next :global(.next__curve) {
    inset: 10% 0 0 0;
    width: 100%;
    height: 80%;
  }
  .next__grid {
    row-gap: var(--space-s);
    align-items: end;
  }
  .next__label {
    grid-column: 1 / -1;
    display: inline-flex;
    gap: 0.75rem;
    align-items: center;
    color: var(--stone);
  }
  .next__title {
    grid-column: 1 / span 7;
    grid-row: 2;
    transition: transform 800ms var(--ease);
  }
  .next__meta {
    grid-column: 1 / span 7;
    grid-row: 3;
    color: var(--on-dark-muted);
  }
  .next__media {
    grid-column: 8 / -1;
    grid-row: 2 / span 2;
    margin-right: calc(var(--gutter) * -1);
  }
  .next :global(.media img) {
    transition: transform 900ms var(--ease);
  }
  @media (hover: hover) {
    .next:hover .next__title {
      transform: translateX(1rem);
    }
    .next:hover :global(.media.is-in img) {
      transform: scale(1.035);
    }
  }

  @media (max-width: 1023px) {
    .ph__meta,
    .ph__summary {
      grid-column: 1 / -1;
    }
    .ph :global(.ph__hero) {
      aspect-ratio: 4 / 3 !important;
    }
    .story__text {
      grid-column: 1 / -1;
    }
    .seq--detail :global(.seq__a) {
      grid-column: 2 / span 7;
    }
    .seq__caption {
      grid-column: 1 / -1;
    }
    .seq--pair :global(.seq__a) {
      grid-column: 1 / span 10;
    }
    .seq--pair :global(.seq__b) {
      grid-column: 4 / -1;
      margin-top: 0;
    }
    .seq--crop :global(.seq__a) {
      grid-column: 1 / -1;
      aspect-ratio: 4 / 3 !important;
    }
    .next__title,
    .next__meta,
    .next__media {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .next__media {
      margin-right: 0;
      margin-top: var(--space-s);
    }
  }
</style>
