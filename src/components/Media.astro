---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  ratio?: string;
  reveal?: 'mask' | false;
  from?: 'bottom' | 'left' | 'right';
  parallax?: boolean;
  eager?: boolean;
  vtName?: string;
  class?: string;
  position?: string;
  delay?: number;
  grade?: boolean;
}

const {
  src,
  alt,
  sizes,
  ratio,
  reveal = 'mask',
  from = 'bottom',
  parallax = false,
  eager = false,
  vtName,
  class: cls = '',
  position,
  delay,
  grade = true,
} = Astro.props;

const candidates = [480, 720, 960, 1280, 1600, 2000, 2400];
const widths = candidates.filter((w) => w <= src.width);
if (!widths.includes(src.width) && src.width < 2400) widths.push(src.width);

const style = [ratio ? `aspect-ratio:${ratio}` : '', delay ? `--d:${delay}ms` : ''].filter(Boolean).join(';');
---

<figure
  class:list={['media', grade && 'media--grade', cls]}
  style={style || undefined}
  data-reveal={reveal || undefined}
  data-from={reveal && from !== 'bottom' ? from : undefined}
>
  <div class="media__inner" data-parallax={parallax || undefined}>
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding={eager ? 'sync' : 'async'}
      style={position ? `object-position:${position}` : undefined}
      transition:name={vtName}
    />
  </div>
  <slot />
</figure>
