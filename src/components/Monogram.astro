---
/* Geçici tipografik monogram. Temiz vektör logo hazır olduğunda bu bileşen SVG ile değiştirilir. */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<span class:list={['mono', cls]} aria-hidden="true"><span class="mono__s">S</span><span class="mono__n">N</span></span>

<style>
  .mono {
    position: relative;
    display: inline-block;
    width: 1.18em;
    height: 1.05em;
    font-family: var(--serif);
    font-weight: 300;
    line-height: 1;
    font-variation-settings: 'opsz' 72;
  }
  .mono span {
    position: absolute;
  }
  .mono__s {
    left: 0;
    bottom: -0.04em;
    font-size: 0.92em;
  }
  .mono__n {
    right: 0;
    top: -0.06em;
    font-size: 0.92em;
  }
</style>
