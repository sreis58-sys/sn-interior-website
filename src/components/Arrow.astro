---
interface Props {
  class?: string;
  dir?: 'right' | 'down' | 'up-right';
}
const { class: cls = '', dir = 'right' } = Astro.props;
const rotate = dir === 'down' ? 90 : dir === 'up-right' ? -45 : 0;
---

<svg
  class:list={['arrow', cls]}
  viewBox="0 0 22 12"
  fill="none"
  stroke="currentColor"
  stroke-width="1.1"
  aria-hidden="true"
  style={rotate ? `rotate:${rotate}deg` : undefined}
>
  <path d="M0 6h20.5M15.5 1l5 5-5 5"></path>
</svg>
