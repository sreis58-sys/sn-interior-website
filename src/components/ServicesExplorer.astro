---
import { Image } from 'astro:assets';
import { services } from '../data/site';

interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
const sizes = '(min-width: 1024px) 46vw, 100vw';
---

<div class="sx" data-services>
  <ol role="list" class="sx__list">
    {
      services.map((s, i) => (
        <li class:list={['sx__item', i === 0 && 'is-active']} data-service id={`hizmet-${s.no}`}>
          <h3 class="sx__head">
            <button type="button" class="sx__btn">
              <span class="sx__no">{s.no}</span>
              <span class="sx__title">{s.title}</span>
            </button>
          </h3>
          <div class="sx__panel">
            <div class="sx__panel-inner">
              <figure class="sx__mobile-img media media--grade">
                <Image src={s.image} alt={s.alt} widths={[480, 720, 960]} sizes="100vw" loading="lazy" />
              </figure>
              <p class="sx__lead">{s.lead}</p>
              <p class="sx__text muted">{s.text}</p>
              {detailed && (
                <ul role="list" class="sx__items small">
                  {s.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="sx__viewport" aria-hidden="true">
    {
      services.map((s, i) => (
        <figure class:list={['sx__img', 'media--grade', i === 0 && 'is-active']} data-service-img>
          <Image src={s.image} alt="" widths={[720, 960, 1280, 1600]} sizes={sizes} loading="lazy" />
        </figure>
      ))
    }
  </div>
</div>

<style>
  .sx {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    padding-left: var(--gutter);
  }
  .sx__list {
    grid-column: 1 / span 6;
    border-top: 1px solid var(--line);
  }
  .sx__item {
    border-bottom: 1px solid var(--line);
  }
  .sx__head {
    font: inherit;
    letter-spacing: normal;
  }
  .sx__btn {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-items: baseline;
    width: 100%;
    padding-block: clamp(1.1rem, 2vw, 1.75rem);
    text-align: left;
  }
  .sx__no {
    font-family: var(--serif);
    font-size: 0.95rem;
    color: var(--coral);
  }
  .sx__title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.8rem, 1rem + 2.6vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.025em;
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease);
  }
  .sx__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-2) var(--ease);
  }
  .sx__panel-inner {
    overflow: hidden;
    padding-left: 3rem;
  }
  .sx__lead {
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.3;
    margin-bottom: 0.6rem;
  }
  .sx__text {
    max-width: 30rem;
  }
  .sx__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 1rem;
  }
  .sx__items li::before {
    content: '— ';
    color: var(--coral);
  }
  .sx__item.is-active .sx__panel {
    grid-template-rows: 1fr;
  }
  .sx__item.is-active .sx__panel-inner {
    padding-bottom: 1.75rem;
  }
  .sx__mobile-img {
    display: none;
  }

  @media (min-width: 1024px) {
    .sx__item:not(.is-active) .sx__title {
      opacity: 0.32;
    }
    .sx__item.is-active .sx__title {
      transform: translateX(0.75rem);
    }
    @media (hover: hover) {
      .sx__item:not(.is-active) .sx__btn:hover .sx__title {
        opacity: 0.6;
      }
    }
  }

  .sx__viewport {
    grid-column: 8 / -1;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    align-self: start;
    aspect-ratio: 4 / 5;
    max-height: calc(100svh - var(--header-h) - 4rem);
    width: 100%;
    overflow: hidden;
    background: var(--bone-2);
  }
  .sx__img {
    position: absolute;
    inset: 0;
    margin: 0;
    clip-path: inset(100% 0 0 0);
    transition: none;
  }
  .sx__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 1.4s var(--ease);
  }
  .sx__img.is-active {
    clip-path: inset(0 0 0 0);
    z-index: 2;
    transition: clip-path 1s var(--ease-io);
  }
  .sx__img.is-active img {
    transform: scale(1);
  }
  .sx__img.is-leaving {
    clip-path: inset(0 0 100% 0);
    z-index: 1;
    transition: clip-path 1s var(--ease-io);
  }
  /* Mobil & tablet: hover yok — dikey editoryal akış, her şey açık */
  @media (max-width: 1023px) {
    .sx {
      padding-right: var(--gutter);
    }
    .sx__list {
      grid-column: 1 / -1;
    }
    .sx__viewport {
      display: none;
    }
    .sx__btn {
      cursor: default;
      pointer-events: none;
    }
    .sx__panel {
      grid-template-rows: 1fr;
    }
    .sx__panel-inner {
      padding-left: 0;
      padding-bottom: 2.25rem;
    }
    .sx__mobile-img {
      display: block;
      aspect-ratio: 16 / 10;
      margin-bottom: 1.25rem;
    }
    .sx__mobile-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
  /* Tablet: görsel solda küçük, metin sağda — telefon akışının büyütülmüş hali değil */
  @media (min-width: 600px) and (max-width: 1023px) {
    .sx__panel-inner {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      column-gap: var(--col-gap);
      align-items: start;
    }
    .sx__mobile-img {
      grid-row: 1 / span 3;
      aspect-ratio: 4 / 3;
      margin-bottom: 0;
    }
    .sx__panel-inner > :not(.sx__mobile-img) {
      grid-column: 2;
    }
  }
</style>
